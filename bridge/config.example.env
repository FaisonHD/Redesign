# Generate two different random tokens locally. Never commit config.env.
HUB_APP_TOKEN=replace_with_at_least_32_random_characters_for_android
HUB_MCP_TOKEN=replace_with_a_different_random_token_for_mcp_admin
HUB_PUBLIC_URL=https://hub.example.de
# Optional separate read-only bearer token, also at least 32 random characters.
# HUB_MCP_READ_TOKEN=
# Add redirect hosts only for MCP clients you intend to connect.
HUB_OAUTH_REDIRECT_HOSTS=chatgpt.com,chat.openai.com,localhost,127.0.0.1
